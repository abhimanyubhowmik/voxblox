<?xml version="1.0" encoding="ISO-8859-15"?>
<launch>
  <arg name="voxel_size" default="0.20"/>

  <!-- These are the datasets from http://www.v4rl.ethz.ch/research/datasets-code/V4RL-Dense-Reconstruction-Dataset.html -->

    <arg name="voxblox_config_file" default="$(find voxblox_ros)/cfg/underwater_dataset.yaml"/>

  <node name="voxblox_node" pkg="voxblox_ros" type="tsdf_server" output="screen" args="--alsologtostderr" clear_params="true">
    <remap from="pointcloud" to="/depth_registered/points"/>
    <remap from="confidence" to="/raftstereo/confidence"/>

    <rosparam command="load" file="$(arg voxblox_config_file)" />
    <rosparam command="load" file="$(find voxblox_ros)/cfg/calibrations/camera_intrinsics.yaml" />

    <param name="mesh_filename" value="$(find voxblox_ros)/mesh_results/$(anon rgbd).ply" />
  </node>

  <!-- Publish accumulated trajectory path from ROVIO odometry -->
  <node name="odometry_to_path" pkg="voxblox_ros" type="odometry_to_path.py"
        output="screen">
    <param name="odometry_topic"  value="/rovio/odometry"/>
    <param name="path_topic"      value="/rovio/path"/>
    <param name="min_distance_m"  value="0.02"/>
    <param name="max_poses"       value="10000000"/>
  </node>

</launch>
